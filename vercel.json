{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/**,web/**,assets/**}",
      "excludeFiles": "{tests/**,docs/**,**/__pycache__/**,web/data.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
