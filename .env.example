# MPF — copy to .env and fill in. NEVER commit .env (it's in .gitignore).
# Locally:  export $(grep -v '^#' .env | xargs)
# Deployed: paste these into the host's environment-variable settings instead.

# ---------------------------------------------------------------- REQUIRED

# OANDA — the main feed. Free practice account, no card.
# Walkthrough: docs/OANDA.md
# Get it: oanda.com -> register (choose PRACTICE) -> My Account -> Manage API Access
OANDA_TOKEN=

# practice | live.  Keep this on practice.
# A live token can place trades; MPF never needs that.
OANDA_ENV=practice


# ---------------------------------------------------------------- REQUIRED TO DEPLOY

# Shared key protecting /api/. Without it MPF answers on localhost only.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Why it matters: docs/DEPLOY.md
MPF_TOKEN=


# ---------------------------------------------------------------- OPTIONAL

# Twelve Data — second source for forex and XAU/XAG. Free tier.
# twelvedata.com -> sign up -> API key
TWELVEDATA_KEY=

# Alerts. Leave blank to disable; MPF just won't send anything.
# Telegram is the easiest: message @BotFather -> /newbot -> copy the token,
# then message your new bot once and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
MPF_TELEGRAM_TOKEN=
MPF_TELEGRAM_CHAT_ID=

# Comma-separated instruments the alert scan watches.
MPF_WATCHLIST=EURUSD,XAUUSD

# Minimum confluence score before an alert fires (0-15).
# A number, not a verdict — see RULEBOOK §10.
MPF_ALERT_MIN_SCORE=10
